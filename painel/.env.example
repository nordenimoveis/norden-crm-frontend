# Painel Norden CRM — variáveis do front-end (Next.js).
# Copie para ".env.local" no desenvolvimento; em produção use o docker-compose (infra/).

# URL interna da API do CRM. O painel fala com a API SÓ pelo servidor (proxy),
# nunca do navegador — por isso não precisamos de CORS.
#  - Desenvolvimento: http://localhost:3333
#  - Produção (rede interna do Docker): http://crm-api:3333
CRM_API_URL=http://localhost:3333

# NODE_ENV controla o atributo "secure" do cookie de sessão:
# em produção o cookie só trafega por HTTPS. Em dev (http) fica sem "secure".
NODE_ENV=development
